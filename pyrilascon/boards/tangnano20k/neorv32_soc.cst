// NEORV32 + Ascon accelerator SoC - Tang Nano 20K pin constraints.
// clk (27 MHz) and LEDs are verified; UART pins to the onboard BL616 vary by
// board revision - CHECK against the Sipeed Tang Nano 20K schematic.

IO_LOC  "clk_i" 4;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard USB-UART (BL616). Verify pin numbers against your schematic.
IO_LOC  "uart0_txd_o" 69;
IO_PORT "uart0_txd_o" IO_TYPE=LVCMOS33;
IO_LOC  "uart0_rxd_i" 70;
IO_PORT "uart0_rxd_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Six LEDs (active-low, 1.8 V bank).
IO_LOC  "led_o[0]" 15;
IO_LOC  "led_o[1]" 16;
IO_LOC  "led_o[2]" 17;
IO_LOC  "led_o[3]" 18;
IO_LOC  "led_o[4]" 19;
IO_LOC  "led_o[5]" 20;
IO_PORT "led_o[0]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_o[1]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_o[2]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_o[3]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_o[4]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_o[5]" IO_TYPE=LVCMOS18 DRIVE=8;
