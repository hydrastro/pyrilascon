// ============================================================================
// Tang Nano 20K constraints  --  GW2AR-LV18QN88C8/I7  (family GW2A-18C)
// ============================================================================
//
//   Pins verified against Sipeed Tang Nano 20K references:
//     - clk (27 MHz)         : pin 4
//     - rst_n (button)       : pin 88
//     - led_n[0..5]          : pins 15..20   (active-low, on the 1.8 V bank)
//     - uart_tx / uart_rx    : pins 69 / 70  (onboard BL616 USB-UART)
//
//   Style intentionally minimal (bare IO_LOC, only pull-ups where needed): this
//   is what the open-source yosys + nextpnr-himbaechel + gowin_pack flow builds
//   cleanly on this part, and it avoids any bank-voltage (IO_TYPE) conflict.
//
//   UART note: tx=69 / rx=70 has been validated with the onboard BL616 USB
//   debugger on this target. The firmware runs at 19200 baud. The heartbeat
//   LED remains an independent clock/reset sanity indicator.
//
// ----------------------------------------------------------------------------

// 27 MHz onboard oscillator.
IO_LOC  "clk" 4;
IO_PORT "clk" PULL_MODE=UP;

// Active-low reset button.
IO_LOC  "rst_n" 88;
IO_PORT "rst_n" PULL_MODE=UP;

// Onboard BL616 USB-UART (hardware-validated mapping).
IO_LOC "uart_tx" 69;
IO_LOC "uart_rx" 70;

// Six active-low onboard LEDs.
IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
